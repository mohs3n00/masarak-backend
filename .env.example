# ==============================================================================
# Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (Prisma/Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Connect to Supabase via connection pooling with ?pgbouncer=true if needed
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="your-super-secret-access-key"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Storage (Supabase Storage & Cloudinary)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------------------------------
# Mail (SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USER="user@example.com"
MAIL_PASS="password"
MAIL_FROM='"Masarak" <noreply@masarak.com>'

# ------------------------------------------------------------------------------
# Firebase Admin
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Redis (Cache & Queue)
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# SMS Providers
# ------------------------------------------------------------------------------
# Twilio
TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="your-twilio-number"

# Unifonic
UNIFONIC_APP_SID="your-unifonic-app-sid"
UNIFONIC_SENDER_ID="your-sender-id"

# Infobip
INFOBIP_BASE_URL="https://your-base-url.api.infobip.com"
INFOBIP_API_KEY="your-infobip-api-key"
INFOBIP_SENDER="your-sender"

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL="debug"

# ------------------------------------------------------------------------------
# Appwrite Community Database
# ------------------------------------------------------------------------------
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_API_KEY=
APPWRITE_DATABASE_ID=masarak_community
APPWRITE_BUCKET_ID=community-attachments

# ------------------------------------------------------------------------------
# AI Lesson Summarization & PDF Generation
# ------------------------------------------------------------------------------
OPENROUTER_ENDPOINT=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_API_KEY=
OPENROUTER_GEMINI_MODEL=google/gemini-2.5-pro
OPENROUTER_CHATGPT_MODEL=openai/gpt-5-mini

APPWRITE_LESSON_COLLECTION_ID=Lessons
APPWRITE_AI_JOBS_COLLECTION_ID=AIJobs
APPWRITE_AI_OUTPUTS_COLLECTION_ID=AIOutputs
APPWRITE_AI_METADATA_COLLECTION_ID=AIMetadata
APPWRITE_AI_USAGE_COLLECTION_ID=AIUsage
APPWRITE_AI_LOGS_COLLECTION_ID=Logs
APPWRITE_LESSON_BUCKET_ID=lesson-assets

LESSON_SUMMARY_DESIGN_VERSION=v1
LESSON_SUMMARY_PROMPT_DIR=prompts
LESSON_SUMMARY_MANIFEST_PATH=src/modules/lesson-summary/manifest/design-manifest.json
LESSON_SUMMARY_JSON_SCHEMA_VERSION=lesson-json-schema-v1
LESSON_SUMMARY_LAYOUT_VERSION=layout-engine-v1
LESSON_SUMMARY_HTML_RENDERER_VERSION=html-renderer-v1
LESSON_SUMMARY_PDF_RENDERER_VERSION=pdf-renderer-v1
