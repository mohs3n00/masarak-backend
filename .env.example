# ==============================================================================
# Environment Configuration (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# App Configuration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGIN=http://localhost:3000

# ------------------------------------------------------------------------------
# Database (Prisma/Supabase PostgreSQL)
# ------------------------------------------------------------------------------
# Connect to Supabase via connection pooling with ?pgbouncer=true if needed
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# Direct connection for migrations
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres"

# ------------------------------------------------------------------------------
# Authentication (JWT)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET="your-super-secret-access-key"
JWT_ACCESS_EXPIRES_IN="15m"

JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_REFRESH_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Storage (Supabase Storage & Cloudinary)
# ------------------------------------------------------------------------------
SUPABASE_URL="https://[PROJECT-REF].supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# ------------------------------------------------------------------------------
# Mail (SMTP)
# ------------------------------------------------------------------------------
MAIL_HOST="smtp.example.com"
MAIL_PORT=587
MAIL_USER="user@example.com"
MAIL_PASS="password"
MAIL_FROM='"Masarak" <noreply@masarak.com>'

# ------------------------------------------------------------------------------
# Firebase Admin
# ------------------------------------------------------------------------------
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ------------------------------------------------------------------------------
# Redis (Cache & Queue)
# ------------------------------------------------------------------------------
REDIS_HOST="localhost"
REDIS_PORT=6379
REDIS_PASSWORD=""

# ------------------------------------------------------------------------------
# SMS Providers
# ------------------------------------------------------------------------------
# Twilio
TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE_NUMBER="your-twilio-number"

# Unifonic
UNIFONIC_APP_SID="your-unifonic-app-sid"
UNIFONIC_SENDER_ID="your-sender-id"

# Infobip
INFOBIP_BASE_URL="https://your-base-url.api.infobip.com"
INFOBIP_API_KEY="your-infobip-api-key"
INFOBIP_SENDER="your-sender"

# ------------------------------------------------------------------------------
# Logging
# ------------------------------------------------------------------------------
LOG_LEVEL="debug"
